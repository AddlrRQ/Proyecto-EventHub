PORT=3000
INSTANCE_NAME=Servidor-Local-Comp
NODE_ENV=development
AUTH_SECRET=genera_una_clave_aleatoria_de_64_caracteres_hex
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=EventHubDB
DB_USER=eventhub_app
DB_PASSWORD=Pon_aqui_contra_SQL_server

# TLS para SQL Server (produccion recomendado: DB_ENCRYPT=true y DB_TRUST_SERVER_CERTIFICATE=false)
# En desarrollo local con certificado autofirmado puedes usar DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Pool de conexiones por instancia Node.js (con 2 EC2: hasta 2 * DB_POOL_MAX conexiones potenciales)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_REQUEST_TIMEOUT_MS=15000
